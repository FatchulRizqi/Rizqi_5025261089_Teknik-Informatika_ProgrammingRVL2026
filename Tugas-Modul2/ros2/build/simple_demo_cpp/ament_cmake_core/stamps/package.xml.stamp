<?xml version="1.0"?>
<package format="3">
  <name>simple_demo_cpp</name>
  <version>0.0.1</version>
  <description>ROS2 package untuk publisher dan subscriber Controller</description>
  <maintainer email="symphony@todo.todo">symphony</maintainer>
  <license>MIT</license>

  <!-- Build type -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Dependencies -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>custom_message</depend>

  <!-- Opsional: kalau kamu generate messages di package ini -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
